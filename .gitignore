# ---------------------------------------------------------------------------
# Android MCP Hub — 绝不入库的东西
# ---------------------------------------------------------------------------

# 依赖
node_modules/

# Cloudflare 本地状态（含本地模拟的 KV/DO 数据）
.wrangler/
worker/.wrangler/

# ★ 真实凭据：本地开发用的明文变量文件。仓库里只有 .dev.vars.example
.dev.vars
*.dev.vars

# 构建产物
dist/*          # 但交付用的那个 APK 例外，见文件末尾
build/
coverage/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.jks
*.keystore
!android/app/debug.keystore

# 编辑器 / 系统
.DS_Store
*.swp
.idea/
.vscode/

# 日志与临时产物
*.log
test-reports/tmp/
e2e/.tmp/

# 例外：Gate 0 的证据日志是要入库的 —— TEST_REPORT.md 逐条引用它们，
# 评审得能自己打开看，而不是只能相信报告里的转述。
# （注意：被忽略的目录里的文件无法用 ! 重新包含，所以上面只忽略 test-reports/tmp/，
#   没有整目录忽略 test-reports/。）
!test-reports/typecheck.log
!test-reports/vitest.log
!test-reports/e2e.log
!test-reports/android-build.log
!test-reports/workerd-not-run.log

# 例外：交付用的 Debug APK 本体（任务书要求"可安装的 APK"，而 Release 是被禁止的，
# 所以只能放进仓库里；用户与审计员要能直接下载，而不是只能相信 SHA-256）。
# 这两个例外必须写在 *.apk / dist/* 之后 —— gitignore 是"最后一条匹配的规则生效"。
!dist/Android-MCP-Hub-Gate0.1-debug.apk
!dist/SHA256SUMS.txt
