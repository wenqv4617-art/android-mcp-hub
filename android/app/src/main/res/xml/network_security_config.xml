<?xml version="1.0" encoding="utf-8"?>
<!--
  默认禁止明文流量。本应用的云端协议是 wss://<host>/phone/ws，不需要 cleartext 例外。

  Gate 3 的唯一例外：**回环地址上的本地 MCP 服务器**。
  «本机上的另一个 App» 或用户自己跑在手机里的 MCP 服务器只能走 http://127.0.0.1:<port>，
  没有证书可谈；而这些流量根本不经过网卡对外发送，加这个例外不会让任何
  出网流量变成明文。例外只覆盖这三个回环主机名，其它任何域名仍然只能是 https。
  注意：这里是**协议层**的放宽，能不能连某个地址由 McpUrlPolicy 判定
  （https 任意主机；http 只允许回环），两道门都要过。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
